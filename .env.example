# APICN001 — copy this file to .env and fill in your real keys (never commit .env)
# -- Real keys: fill in .env (never commit .env) --
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ---- Required: answer generator ----
LLM_PROVIDER=groq                   # slm | groq | openai | anthropic | openrouter
LLM_MODEL=                          # e.g. phi3.5 (slm/Ollama), llama-3.3-70b-versatile (groq), gpt-4o-mini (openai), claude-3-5-haiku-20241022 (anthropic), meta-llama/llama-3.1-8b-instruct (openrouter)
SLM_BASE_URL=http://localhost:11434/v1
SLM_API_KEY=ollama

# ---- API keys (uncomment the one you use) ----
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---- Optional: embeddings ----
EMBEDDING_PROVIDER=local            # local | openai
EMBEDDING_MODEL=                    # e.g. nomic-embed-text (Ollama) | text-embedding-3-small (OpenAI)

# ---- Optional: speech engines ----
STT_PROVIDER=local                  # local | groq | openai   (local = faster-whisper)
STT_MODEL=base                      # whisper size for faster-whisper: tiny/base/small/medium
TTS_PROVIDER=pyttsx3                # pyttsx3 | edge | piper
TTS_VOICE=                          # e.g. en-IN-NeerjaNeural (edge), or HKEY_... (pyttsx3)
TTS_RATE=175                        # speech rate for pyttsx3 (words per minute)

# ---- Retrieval tuning ----
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Paths ----
DATA_DIR=data
INDEX_DIR=index

# ---- App UI ----
UI_MODE=cli                         # cli | web
PORT=7860                           # port for web UI (Gradio)
